{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(git ls-tree *)",
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git rebase *)",
      "Bash(git stash *)",
      "Bash(git push *)",
      "Bash(git fetch *)",
      "Bash(git log *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git branch *)",
      "Bash(git merge-base *)",
      "Bash(npm test)",
      "Bash(npx vitest run *)",
      "Bash(node -e *)",
      "Bash(curl *)",
      "Bash(node -e ' *)",
      "Edit(/.claude/skills/verify-game-changes/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-context.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "snake-local": {
      "source": {
        "source": "directory",
        "path": "d:/Aspire/snake-game"
      }
    }
  },
  "enabledPlugins": {
    "snake-game-standards@snake-local": true
  }
}

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(git ls-tree *)",
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git rebase *)",
      "Bash(git stash *)",
      "Bash(git push *)",
      "Bash(git fetch *)",
      "Bash(git log *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git branch *)",
      "Bash(git merge-base *)",
      "Bash(npm test)",
      "Bash(npx vitest run *)",
      "Bash(node -e *)",
      "Bash(curl *)",
      "Bash(node -e ' *)",
      "Bash(node -e \"let s='';process.stdin.on\\('data',d=>s+=d\\).on\\('end',\\(\\)=>{const j=JSON.parse\\(s\\);for\\(const r of j.workflow_runs??[]\\)console.log\\('  '+[r.name,r.head_branch,r.status,r.conclusion].join\\(' | '\\)\\)}\\)\")",
      "Edit(/.claude/skills/verify-game-changes/**)",
      "Bash(mkdir -p snake-game-plugin/.claude-plugin snake-game-plugin/hooks snake-game-plugin/agents snake-game-plugin/skills/verify-game-changes)",
      "Bash(cp .claude/hooks/format-file.mjs .claude/hooks/block-main-push.mjs .claude/hooks/verify.mjs .claude/hooks/project-root.mjs snake-game-plugin/hooks/)",
      "Bash(cp .claude/agents/cold-reviewer.md snake-game-plugin/agents/)",
      "Bash(cp .claude/skills/verify-game-changes/SKILL.md snake-game-plugin/skills/verify-game-changes/)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-file.mjs\"",
            "timeout": 30,
            "statusMessage": "Formatting"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-main-push.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify.mjs\"",
            "timeout": 300,
            "statusMessage": "Running tests + typecheck"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-context.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
